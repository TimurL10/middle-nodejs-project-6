extends ../layouts/application.pug

block header
  = t('views.users.edit.editProfile')

block content
  +formFor()(action=route('users.update', { id: String(user.id) }) method='post')
    - const firstNameErrors = _.get(errors, 'firstName')
    - const lastNameErrors = _.get(errors, 'lastName')
    - const emailErrors = _.get(errors, 'email')
    - const passwordErrors = _.get(errors, 'password')

    .form-floating.mb-3
      input#data_firstName.form-control(
        class=(!_.isEmpty(firstNameErrors) ? 'is-invalid' : '')
        name='data[firstName]'
        type='text'
        placeholder=t('views.users.edit.firstName')
        value=_.get(user, 'firstName', '')
      )
      label(for='data_firstName')= t('views.users.edit.firstName')
      if !_.isEmpty(firstNameErrors)
        .form-control-feedback.invalid-feedback= firstNameErrors.map(({ message }) => message).join('. ')

    .form-floating.mb-3
      input#data_lastName.form-control(
        class=(!_.isEmpty(lastNameErrors) ? 'is-invalid' : '')
        name='data[lastName]'
        type='text'
        placeholder=t('views.users.edit.lastName')
        value=_.get(user, 'lastName', '')
      )
      label(for='data_lastName')= t('views.users.edit.lastName')
      if !_.isEmpty(lastNameErrors)
        .form-control-feedback.invalid-feedback= lastNameErrors.map(({ message }) => message).join('. ')

    .form-floating.mb-3
      input#data_email.form-control(
        class=(!_.isEmpty(emailErrors) ? 'is-invalid' : '')
        name='data[email]'
        type='text'
        placeholder=t('views.users.email')
        value=_.get(user, 'email', '')
      )
      label(for='data_email')= t('views.users.email')
      if !_.isEmpty(emailErrors)
        .form-control-feedback.invalid-feedback= emailErrors.map(({ message }) => message).join('. ')

    .form-floating.mb-3
      input#data_password.form-control(
        class=(!_.isEmpty(passwordErrors) ? 'is-invalid' : '')
        name='data[password]'
        type='password'
        placeholder=t('views.users.edit.password')
      )
      label(for='data_password')= t('views.users.edit.password')
      if !_.isEmpty(passwordErrors)
        .form-control-feedback.invalid-feedback= passwordErrors.map(({ message }) => message).join('. ')

    input.btn.btn-primary(type='submit' value=t('views.users.edit.submit'))

extends ../layouts/application.pug

block header
  = t('views.labels.index.header')

block content
  a.btn.btn-primary.mb-3(href=route('newLabel'))= t('views.labels.index.create')

  table.table.table-striped
    thead
      tr
        th= t('views.labels.id')
        th= t('views.labels.name')
        th= t('views.labels.createdAt')
        th
    tbody
      each label in labels
        tr
          td= label.id
          td= label.name
          td= formatDate(label.createdAt)
          td
            a.btn.btn-primary.me-2(href=route('editLabel', { id: String(label.id) }))= t('views.labels.edit.action')
            form.d-inline(action=route('deleteLabel', { id: String(label.id) }) method='post')
              input.btn.btn-danger(type='submit' value=t('views.labels.delete.action'))

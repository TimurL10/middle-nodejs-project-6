extends ../layouts/application.pug

block header
  = t('views.labels.edit.header')

block content
  +formFor()(action=route('updateLabel', { id: String(label.id) }) method='post')
    - const nameErrors = _.get(errors, 'name')

    .form-floating.mb-3
      input#data_name.form-control(
        class=(!_.isEmpty(nameErrors) ? 'is-invalid' : '')
        name='data[name]'
        type='text'
        placeholder=t('views.labels.name')
        value=_.get(label, 'name', '')
      )
      label(for='data_name')= t('views.labels.name')
      if !_.isEmpty(nameErrors)
        .invalid-feedback= nameErrors.map(({ message }) => message).join('. ')

    input.btn.btn-primary(type='submit' value=t('views.labels.edit.submit'))
